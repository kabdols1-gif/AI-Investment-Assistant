		{
			"name": "002-테스트_Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"function decryptData(key, plainBody) {\r",
							"  const keyBytes = CryptoJS.enc.Utf8.parse(key);\r",
							"  const decryptedBody = CryptoJS.AES.decrypt(plainBody, keyBytes, {\r",
							"    mode: CryptoJS.mode.ECB,\r",
							"    padding: CryptoJS.pad.Pkcs7\r",
							"  });\r",
							"\r",
							"  return decryptedBody.toString(CryptoJS.enc.Utf8);\r",
							"}\r",
							"\r",
							"var jsonData = JSON.parse(responseBody);\r",
							"var encrypt = jsonData.encrypt;\r",
							"var decData = decryptData(postman.getGlobalVariable(\"clientSecret\"), encrypt);\r",
							"\r",
							"console.log(decData);\r",
							"\r",
							""
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"function encryptData(key, plainBody) {\r",
							"  const keyBytes = CryptoJS.enc.Utf8.parse(key);\r",
							"  const encryptedBody = CryptoJS.AES.encrypt(plainBody, keyBytes, {\r",
							"    mode: CryptoJS.mode.ECB,\r",
							"    padding: CryptoJS.pad.Pkcs7\r",
							"  });\r",
							"\r",
							"  return encryptedBody.toString();\r",
							"}\r",
							"\r",
							"var accessToken = postman.getGlobalVariable(\"access_token\");\r",
							"var clientSecret = postman.getGlobalVariable(\"clientSecret\")\r",
							"\r",
							"var reqData = request.data;\r",
							"reqData = reqData.replace(/ /g,\"\");\r",
							"reqData = reqData.replace(/\\n/g,\"\");\r",
							"reqData = reqData.replace(/\\s*/g,\"\");\r",
							"\r",
							"var hash = CryptoJS.HmacSHA256(CryptoJS.enc.Utf8.parse(reqData), accessToken);\r",
							"var hsKey = CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(hash));\r",
							"var encData = encryptData(clientSecret, reqData);\r",
							"\r",
							"postman.setGlobalVariable(\"hsKey\",hsKey);\r",
							"\r",
							"var sendData = \"{\\\"encrypt\\\":\\\"\" + encData + \"\\\"}\";\r",
							"            \r",
							"console.log(\"=======================================\");\r",
							"console.log(\"pre accessToken ==> \" + accessToken);\r",
							"console.log(\"pre hash        ==> \" + hash);\r",
							"console.log(\"pre reqData     ==> \" + reqData);\r",
							"console.log(\"pre encData     ==> \" + encData);\r",
							"console.log(\"pre sendData    ==> \" + sendData);\r",
							"console.log(\"=======================================\");\r",
							"\r",
							"pm.request.body.update(sendData);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "bearer {{access_token}}"
					},
					{
						"key": "hsKey",
						"value": "{{hsKey}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": ""
				},
